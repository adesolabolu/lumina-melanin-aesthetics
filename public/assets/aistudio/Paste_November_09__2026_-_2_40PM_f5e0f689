      document.querySelectorAll('[data-animate-heading]').forEach(heading => {
        const text = heading.textContent.trim().split(/\s+/);
        heading.innerHTML = '';

        text.forEach((word, wordIdx) => {
          // Create a span for the entire word
          const span = document.createElement('span');
          span.textContent = word;
          span.className = 'char'; // Using the existing CSS class for animation styles
          // Incremental delay based on word index for a sequential reveal
          span.style.transitionDelay = `${wordIdx * 0.12}s`;
          heading.appendChild(span);

          // Add space after word if not the last word
          if (wordIdx < text.length - 1) {
            const space = document.createElement('span');
            space.innerHTML = '&nbsp;';
            heading.appendChild(space);
          }
        });
      });

      // 2. Setup Scroll Observer
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-on-scroll-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('[data-animation-on-scroll]').forEach(el => {
        el.classList.add('animate-on-scroll-hidden');
        
        // Apply Directional Classes
        if (el.dataset.animationDirection === 'left') {
          el.classList.add('animate-from-left');
        } else if (el.dataset.animationDirection === 'right') {
          el.classList.add('animate-from-right');
        }
        
        observer.observe(el);
      });
    });
  </script>

</body></html>